# Copy to .env.local. All keys are validated at boot by lib/env.ts (§7).

# Supabase (local: from `pnpm supabase start` output)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit Cloud dev project (§9: do not self-host locally)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Resend (invites, digests). RESEND_FROM must be on a domain verified in Resend;
# without it, invites still allowlist and show a copyable link.
RESEND_API_KEY=
RESEND_FROM="Commune <commune@potarastudio.com>"

# Web Push (generate once: `pnpm dlx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mention digest (§5 Phase 2). Random string shared with the pg_cron job in Supabase Vault;
# see README → Mention digest. Leave empty to turn the digest off.
CRON_SECRET=
